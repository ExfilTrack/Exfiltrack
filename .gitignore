# ============================================================
# FORENSIC EVIDENCE - NEVER COMMIT REAL CASE DATA
# ============================================================
# Acquired evidence and case output directories.
#
# NOTE: these directory patterns are anchored with a leading slash so they
# match only at the repository root. An unanchored pattern such as
# "evidence/" matches at EVERY depth and would silently exclude the source
# package src/exfiltrack/evidence/, which breaks a fresh clone while still
# passing locally. Keep the leading slash.
/evidence/
/cases/
/case_output/
/output/
/reports/

# Evidence file formats. Left unanchored on purpose: acquired evidence may be
# placed in any local directory, and excluding it by extension everywhere is
# the safer default. Synthetic fixtures are re-included at the bottom.
*.evtx
*.lnk
*.automaticDestinations-ms
*.customDestinations-ms
NTUSER.DAT*
SYSTEM
SOFTWARE
SAM
SECURITY
*.hive
*.E01
*.raw
*.dd
*.vhd
*.vhdx

# Generated reports
*.report.html
*.report.json
*.report.csv

# Local configuration and secrets
.env
.env.*
*.local.toml
local_config.*

# ============================================================
# Re-include committed synthetic test data
# ============================================================
# These negations rescue fixture files that the evidence patterns above would
# otherwise exclude, for example tests/fixtures/registry/SYSTEM. Directory
# entries are negated as well, because Git will not descend into an excluded
# directory to re-include files inside it.
!tests/fixtures/
!tests/fixtures/**
!examples/synthetic/
!examples/synthetic/**


